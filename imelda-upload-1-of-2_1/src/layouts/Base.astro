---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import { site, awards, services } from '../lib/data';

interface Props { title: string; description?: string; schema?: Record<string, unknown>[]; noindex?: boolean; }
const { title, description = site.defaultDescription, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.name ? `${site.name}, ${site.signature} | Nairobi` : `${title} | ${site.name}`;
const ogImage = new URL('/og-image.jpg', Astro.site);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': new URL('/#imelda-mutio', Astro.site).href,
  name: site.name, alternateName: site.signature, url: new URL('/', Astro.site).href, image: ogImage.href,
  jobTitle: 'MC, Event Host, Voice-over Artist and Radio Presenter', description: site.defaultDescription,
  address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
  knowsAbout: ['Voice-over', 'Advertising', 'Event hosting', 'Master of ceremonies', 'Radio presenting', 'Interviewing', 'Audience engagement'],
  worksFor: { '@type': 'Organization', name: 'Classic 105' },
  sameAs: site.social.map((s) => s.url),
  email: `mailto:${site.contact.email}`, telephone: site.contact.phoneE164,
  makesOffer: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.short, areaServed: 'Kenya' } })),
};
---
<!doctype html>
<html lang="en-KE" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement; d.classList.replace('no-js', 'js');
        try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t); } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#150A24" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Imelda Mutio, MC, host and voice-over artist" />
    <meta property="og:locale" content="en_KE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <VideoModal />
    <script>
      // Split headline text into words so each can rise out of its own mask.
      // Text stays real text (spans only), so screen readers and search read it normally.
      document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
        let i = 0;
        const walk = (node: Node) => {
          [...node.childNodes].forEach((n) => {
            if (n.nodeType === 3) {
              const parts = (n.textContent || '').split(/(\s+)/);
              const frag = document.createDocumentFragment();
              parts.forEach((p) => {
                if (!p) return;
                if (/^\s+$/.test(p)) { frag.appendChild(document.createTextNode(p)); return; }
                const w = document.createElement('span'); w.className = 'w';
                const inner = document.createElement('span'); inner.textContent = p; inner.style.setProperty('--i', String(i++));
                w.appendChild(inner); frag.appendChild(w);
              });
              n.replaceWith(frag);
            } else if (n.nodeType === 1 && !(n as Element).classList.contains('w')) walk(n);
          });
        };
        walk(el);
      });
      const els = document.querySelectorAll<HTMLElement>('.reveal, [data-split]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
