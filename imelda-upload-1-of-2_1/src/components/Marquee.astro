---
interface Props { words: string[] }
const { words } = Astro.props;
const run = [...words, ...words];
---
<section class="marquee stage" aria-label="What I do" data-marquee>
  <p class="sr-only">{words.join(', ')}</p>
  <div class="track" aria-hidden="true">
    {run.map((w, i) => <span class:list={['w', { o: i % 2 }]}>{w}<i></i></span>)}
  </div>
  <button type="button" class="toggle" data-marquee-toggle aria-pressed="false">Pause motion</button>
</section>
<style>
  .marquee { padding-block: clamp(1.4rem, 1rem + 1.5vw, 2.4rem); border-block: 1px solid var(--stage-line); display: flex; align-items: center; }
  .track { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .marquee.paused .track { animation-play-state: paused; }
  .w { display: inline-flex; align-items: center; gap: clamp(1.2rem, 2vw, 2.4rem); padding-right: clamp(1.2rem, 2vw, 2.4rem); font-family: var(--font-display); font-weight: 700; font-size: clamp(2.2rem, 1.2rem + 4vw, 5.4rem); letter-spacing: -0.045em; line-height: 1; white-space: nowrap; }
  .w.o { color: transparent; -webkit-text-stroke: 1.5px rgba(255,243,246,.7); }
  .w i { width: .32em; height: .32em; border-radius: 50%; background: var(--copper); box-shadow: 0 0 22px 4px rgba(255,92,147,.6); flex: none; }
  .toggle { position: absolute; right: var(--gutter); bottom: .5rem; z-index: 2; font-size: .75rem; font-weight: 700; padding: .3em .8em; border-radius: 999px; border: 1px solid var(--stage-line); background: rgba(21,10,36,.7); color: var(--mist); }
  .toggle:hover { color: var(--ivory); }
  @media (max-width: 700px) { .marquee { padding-bottom: 2.8rem; } }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } .toggle { display: none; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((m) => {
    const b = m.querySelector<HTMLButtonElement>('[data-marquee-toggle]')!;
    b.addEventListener('click', () => {
      const p = !m.classList.contains('paused');
      m.classList.toggle('paused', p); b.setAttribute('aria-pressed', String(p)); b.textContent = p ? 'Play motion' : 'Pause motion';
    });
  });
</script>
