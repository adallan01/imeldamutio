---
/** One shared player. Any element with data-video="<YouTube id>" opens it. */
---
<dialog class="vmodal" data-vmodal aria-label="Video player">
  <div class="frame" data-vframe></div>
  <div class="bar">
    <p class="vt" data-vtitle></p>
    <div class="btn-row">
      <a class="btn btn--glass" data-vlink target="_blank" rel="noopener">Open on YouTube<span class="sr-only"> (opens in a new tab)</span></a>
      <button class="btn btn--primary" type="button" data-vclose>Close</button>
    </div>
  </div>
</dialog>
<style>
  .vmodal { width: min(1100px, 94vw); max-height: 92vh; padding: 0; border: 0; border-radius: var(--r-lg); background: var(--stage); color: var(--ivory); overflow: hidden; box-shadow: 0 40px 120px -20px rgba(0,0,0,.8); }
  .vmodal::backdrop { background: rgba(12,5,20,.82); backdrop-filter: blur(8px); }
  .vmodal[open] { animation: pop .45s var(--ease-out); }
  .frame { aspect-ratio: 16 / 9; background: #000; }
  .frame :global(iframe) { width: 100%; height: 100%; border: 0; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem 1.25rem; }
  .vt { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); letter-spacing: -0.02em; max-width: 52ch; }
  @keyframes pop { from { opacity: 0; transform: scale(.96) translateY(10px); } to { opacity: 1; transform: none; } }
</style>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-vmodal]')!;
  const frame = dlg.querySelector<HTMLElement>('[data-vframe]')!;
  const title = dlg.querySelector<HTMLElement>('[data-vtitle]')!;
  const link = dlg.querySelector<HTMLAnchorElement>('[data-vlink]')!;
  let opener: HTMLElement | null = null;
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-video]');
    if (!t) return;
    e.preventDefault(); opener = t;
    const id = t.dataset.video!;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = t.dataset.videoTitle || 'Video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    frame.replaceChildren(iframe);
    title.textContent = t.dataset.videoTitle || '';
    link.href = `https://www.youtube.com/watch?v=${id}`;
    dlg.showModal();
    dlg.querySelector<HTMLButtonElement>('[data-vclose]')?.focus();
  });
  const close = () => dlg.close();
  dlg.querySelector('[data-vclose]')!.addEventListener('click', close);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  dlg.addEventListener('close', () => { frame.replaceChildren(); opener?.focus(); });
</script>
