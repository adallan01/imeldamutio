---
import ToneImage from './ToneImage.astro';
import { thumbs } from '../lib/photos';
interface Props { id: string; title: string; source: string; date?: string }
const { id, title, source, date } = Astro.props;
const thumb = thumbs[id];
---
<li class="vcard">
  <button type="button" class="vbtn tone-host" data-video={id} data-video-title={title} aria-label={`Play video: ${title}`}>
    <span class="media">
      {thumb
        ? <ToneImage src={thumb} alt="" widths={[420, 720, 1000]} sizes="(min-width: 900px) 460px, 84vw" />
        : <img class="yt" src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />}
      <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
    </span>
    <span class="meta">
      <span class="t">{title}</span>
      <span class="s">{source}{date ? `, ${date}` : ''}</span>
    </span>
  </button>
</li>
<style>
  .vcard { list-style: none; }
  .vbtn { all: unset; cursor: pointer; display: grid; gap: .9rem; width: 100%; }
  .vbtn:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: var(--r-md); }
  .media { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: var(--r-md); overflow: hidden; background: var(--stage-2); box-shadow: 0 24px 50px -30px rgba(70,12,50, .8); }
  .yt { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(21,10,36,.7)); pointer-events: none; }
  .play { position: absolute; z-index: 2; left: 1rem; bottom: 1rem; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--copper); color: var(--stage); box-shadow: 0 0 0 0 rgba(255,92,147,.6); transition: transform .35s var(--ease-out), box-shadow .5s; }
  .play svg { width: 22px; height: 22px; margin-left: 3px; }
  .vbtn:hover .play, .vbtn:focus-visible .play { transform: scale(1.12); box-shadow: 0 0 0 14px rgba(255,92,147,0); }
  .meta { display: grid; gap: .25rem; }
  .t { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: 1.2; letter-spacing: -0.02em; }
  .s { font-size: var(--step--1); color: var(--text-2); }
</style>
