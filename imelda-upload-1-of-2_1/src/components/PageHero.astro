---
import { Image } from 'astro:assets';
import { stages, stagePos, cutouts, type StageKey, type CutoutKey } from '../lib/photos';
interface Props { kicker: string; title: string; lede?: string; stage?: StageKey; cutout?: CutoutKey; word?: string }
const { kicker, title, lede, stage = 'spotlight', cutout, word } = Astro.props;
---
<section class:list={['phero stage grain', { 'has-cut': cutout }]}>
  <div class="backdrop" aria-hidden="true"><Image src={stages[stage]} alt="" widths={[700, 1200, 1800]} sizes="100vw" loading="eager" style={`object-position:${stage === 'gala' ? '50% 90%' : '50% 0%'}`} /></div>
  <div class="beams" aria-hidden="true"></div>
  {word && <p class="word" aria-hidden="true">{word}</p>}
  {cutout && <div class="cut"><Image src={cutouts[cutout].src} alt={cutouts[cutout].alt} widths={[400, 700, 1000]} sizes="(min-width: 960px) 34vw, 70vw" loading="eager" /></div>}
  <div class="wrap copy">
    <p class="kicker">{kicker}</p>
    <h1 class="h1" data-split>{title}</h1>
    {lede && <p class="lede reveal" style="--d:.25s">{lede}</p>}
    <slot />
  </div>
</section>
<style>
  .phero { min-height: min(78svh, 760px); display: grid; align-items: end; padding-top: calc(var(--header-h) + 3rem); }
  .backdrop { -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - var(--fade-h)), transparent); mask-image: linear-gradient(180deg, #000 calc(100% - var(--fade-h)), transparent); }
  .backdrop::after { background: linear-gradient(180deg, rgba(21,10,36,.35), rgba(21,10,36,.55) 50%, rgba(21,10,36,.96)); }
  .copy { position: relative; z-index: 2; display: grid; gap: 1.1rem; justify-items: start; padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
  .copy .h1 { max-width: 14ch; font-size: clamp(2.1rem, 1.3rem + 3.6vw, 5.2rem); }
  @media (max-width: 700px) { .phero { min-height: 64svh; } .lede { font-size: 1rem; } }
  .lede { color: rgba(255,243,246,.84); }
  .word { position: absolute; z-index: -1; right: -1vw; bottom: 4%; font-family: var(--font-display); font-weight: 800; font-size: clamp(6rem, 24vw, 24rem); line-height: .8; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1.5px rgba(255,190,220,.22); white-space: nowrap; pointer-events: none; }
  .cut { position: absolute; z-index: 1; bottom: 0; right: 4vw; width: min(36vw, 520px); }
  .cut { filter: drop-shadow(0 0 40px rgba(255,92,147,.38)); }
  .cut::before { content: ''; position: absolute; z-index: -1; left: 8%; right: 8%; bottom: 0; height: 86%; border-radius: 999px 999px 0 0; background: linear-gradient(180deg, rgba(255,92,147,.3), rgba(201,182,255,.14) 70%, transparent); box-shadow: inset 0 0 0 1.5px rgba(255,214,232,.2); }
  .cut :global(img) { width: 100%; max-height: calc(min(78svh, 760px) - var(--header-h) - 2.5rem); object-fit: contain; object-position: bottom; -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent); mask-image: linear-gradient(180deg, #000 80%, transparent); }
  @media (max-width: 899px) {
    .cut { right: -6vw; width: 62vw; opacity: .6; }
    .word { bottom: auto; top: calc(var(--header-h) + .5rem); -webkit-text-stroke-color: rgba(255,190,220,.16); }
  }
</style>
