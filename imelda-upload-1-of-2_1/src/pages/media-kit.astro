---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, services, shows } from '../lib/data';
import bios from '../../data/bios.json';
import p1 from '../assets/press/portrait-1.jpg';
import p2 from '../assets/press/portrait-2.jpg';
import p3 from '../assets/press/portrait-3.jpg';
import p4 from '../assets/press/portrait-4.jpg';
const portraits = [
  { img: p1, file: '/downloads/portraits/imelda-mutio-portrait-1.jpg', label: 'Pink blazer, 1600 x 2000', alt: 'Imelda Mutio in a pink blazer, lowering her glasses and pointing at the camera' },
  { img: p2, file: '/downloads/portraits/imelda-mutio-portrait-2.jpg', label: 'Orange blazer, 1600 x 2000', alt: 'Imelda Mutio smiling in an orange pinstripe blazer' },
  { img: p3, file: '/downloads/portraits/imelda-mutio-portrait-3.jpg', label: 'Black cardigan, 1600 x 2000', alt: 'Imelda Mutio standing in a black cardigan and jeans' },
  { img: p4, file: '/downloads/portraits/imelda-mutio-portrait-4.jpg', label: 'Trench coat, 1600 x 2000', alt: 'Imelda Mutio smiling in a beige trench coat' },
];
const show = shows[0];
const facts = [
  ['Name', 'Imelda Mutio'], ['Known as', site.signature], ['Based in', `${site.location}, available across Kenya`],
  ['Book me for', services.map((s) => s.name).join(', ')], ['On air', show ? `${show.title}, ${show.displayDate.toLowerCase()}` : ''],
];
---
<Base title="Media Kit" description="Imelda Mutio's media kit: bios, programme introduction, portraits and booking details for organisers, journalists and brand partners.">
  <PageHero kicker="Media kit" title="Everything your producer will ask for." lede="Bios for the programme, portraits for the poster, and all the details in one PDF." stage="podium" cutout="stripes">
    <div class="btn-row">
      <a href="/downloads/imelda-mutio-media-kit.pdf" class="btn btn--primary" download>Download the media kit (PDF)</a>
      <a href="/contact/" class="btn btn--glass">Request a proposal</a>
    </div>
  </PageHero>
  <section class="room section" aria-labelledby="f-h">
    <div class="wrap kit">
      <div>
        <h2 id="f-h" class="h2">Fast facts</h2>
        <dl class="facts">
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          <div><dt>Bookings</dt><dd><a href={`tel:${site.contact.phoneE164}`}>{site.contact.phoneDisplay}</a><br /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
        </dl>
      </div>
      <div>
        <h2 class="h2">Bios</h2>
        <div class="bios">
          {bios.map((b, i) => (
            <details open={i === 0}>
              <summary>{b.label}<span class="muted"> · {b.text.split(/\s+/).length} words</span></summary>
              <p>{b.text}</p>
            </details>
          ))}
        </div>
        <a href="/about/#bios" class="text-link more">Copy bios with one click</a>
      </div>
    </div>
  </section>
  <section class="room-2 section" aria-labelledby="p-h">
    <div class="wrap">
      <div class="head head--split">
        <h2 id="p-h" class="h1" data-split>Approved portraits.</h2>
        <p class="lede">High-resolution JPGs. Please don't crop through the face, recolour or add effects. Credit the photographer where known.</p>
      </div>
      <ul class="portraits">
        {portraits.map((p) => (
          <li>
            <a href={p.file} download class="pt">
              <Image src={p.img} alt={p.alt} widths={[300, 520]} sizes="(min-width: 900px) 23vw, 46vw" />
              <span class="pt-label">{p.label}<span class="dl">Download JPG</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted disc">{site.disclaimer}</p>
    </div>
  </section>
</Base>
<style>
  .kit { display: grid; gap: 3.5rem; }
  @media (min-width: 960px) { .kit { grid-template-columns: 1.1fr 1fr; gap: 5rem; } }
  .kit > div { display: grid; gap: 1.4rem; align-content: start; }
  .facts { display: grid; border-top: 1.5px solid var(--text); }
  .facts div { display: grid; gap: .3rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  @media (min-width: 600px) { .facts div { grid-template-columns: 9rem 1fr; gap: 1.5rem; } }
  .facts dt { font-weight: 700; color: var(--link); }
  .facts dd { margin: 0; overflow-wrap: anywhere; }
  .facts a { color: var(--text); }
  details { border-top: 1px solid var(--line); padding-block: 1rem; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { font-family: var(--font-display); font-weight: 600; cursor: pointer; font-size: var(--step-1); }
  details p { margin-top: .7rem; color: var(--text-2); }
  .more { font-weight: 700; }
  .portraits { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .portraits { grid-template-columns: repeat(4, 1fr); } }
  .pt { position: relative; display: block; border-radius: var(--r-md); overflow: hidden; text-decoration: none; color: var(--ivory); background: var(--stage); }
  .pt :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%; transition: transform 1s var(--ease-out); }
  .pt:hover :global(img) { transform: scale(1.05); }
  .pt-label { position: absolute; inset: auto 0 0 0; padding: 1rem; display: grid; gap: .2rem; font-weight: 700; font-size: .9rem; background: linear-gradient(180deg, transparent, rgba(21,10,36,.9)); }
  .dl { color: var(--copper); font-family: var(--font-display); }
  .disc { margin-top: 2.5rem; font-size: var(--step--1); max-width: 90ch; }
</style>
