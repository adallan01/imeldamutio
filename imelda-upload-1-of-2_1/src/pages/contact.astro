---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { stages, cutouts } from '../lib/photos';
import { site, services } from '../lib/data';

const endpoint = (import.meta.env.PUBLIC_ENQUIRY_ENDPOINT as string | undefined) || site.form.endpoint;
const mode = site.form.mode === 'endpoint' && !endpoint ? 'mailto' : site.form.mode;
const serviceOptions = [...services.map((s) => s.name), 'Media or interview request', 'Not sure yet'];
const eventTypes = ['Voice-over', 'Ad or brand campaign', 'Corporate event', 'Conference or panel', 'Award show or gala', 'Brand activation or launch', 'Community or lifestyle event', 'Workshop or training', 'Festival or live show', 'Podcast or interview', 'Other'];
const audience = ['Under 100', '100 to 300', '300 to 1,000', 'Over 1,000', 'Not sure yet'];
---
<Base title="Book Imelda: Enquire About Availability" description="Book Imelda Mutio for a voice-over, an ad or brand campaign, or as MC and event host. Share your date, format and audience.">
  <section class="stage grain booking-hero">
    <div class="backdrop" aria-hidden="true"><Image src={stages.spotlight} alt="" widths={[700, 1200, 1800]} sizes="100vw" loading="eager" /></div>
    <div class="beams" aria-hidden="true"></div>
    <div class="bh-cut" aria-hidden="true"><Image src={cutouts.coral.src} alt="" widths={[400, 700]} sizes="30vw" loading="eager" /></div>
    <div class="wrap bh">
      <div>
        <p class="kicker">Bookings</p>
        <h1 class="h1" data-split>Let's make something people <span class="serif">remember.</span></h1>
        <p class="lede reveal" style="--d:.2s">Tell me about your event, ad or voice-over. The more you share about the audience and format, the more useful my first reply will be.</p>
      </div>
      <div class="direct">
        <p class="d-head">Prefer to talk?</p>
        <a class="d-line" href={`tel:${site.contact.phoneE164}`}>{site.contact.phoneDisplay}</a>
        <a class="d-line mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        {site.contact.whatsappEnabled && <a class="btn btn--ghost" href={`https://wa.me/${site.contact.phoneE164.replace('+', '')}`} target="_blank" rel="noopener">WhatsApp</a>}
      </div>
    </div>
  </section>

  <section class="room section">
    <div class="wrap form-grid">
      <form id="booking" class="booking" novalidate
        name="booking" method="POST"
        data-mode={mode} data-endpoint={endpoint} data-email={site.contact.email}
        {...(mode === 'netlify' ? { 'data-netlify': 'true', 'netlify-honeypot': 'company_website' } : {})}>
        <input type="hidden" name="form-name" value="booking" />
        <p class="hp" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>

        <fieldset>
          <legend>About you</legend>
          <div class="row">
            <div class="field"><label for="f-name">Full name <span class="req" aria-hidden="true">*</span></label><input id="f-name" name="name" autocomplete="name" required /><p class="err" id="e-name"></p></div>
            <div class="field"><label for="f-org">Organisation <span class="req" aria-hidden="true">*</span></label><input id="f-org" name="organisation" autocomplete="organization" required /><p class="err" id="e-organisation"></p></div>
          </div>
          <div class="row">
            <div class="field"><label for="f-email">Work email <span class="req" aria-hidden="true">*</span></label><input id="f-email" name="email" type="email" autocomplete="email" required /><p class="err" id="e-email"></p></div>
            <div class="field"><label for="f-phone">Telephone <span class="req" aria-hidden="true">*</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+254 …" required pattern="^[+0-9 ()\-]{7,20}$" /><p class="err" id="e-phone"></p></div>
          </div>
        </fieldset>

        <fieldset>
          <legend>About the project or event</legend>
          <div class="row">
            <div class="field"><label for="f-event">Project or event name <span class="req" aria-hidden="true">*</span></label><input id="f-event" name="event_name" required /><p class="err" id="e-event_name"></p></div>
            <div class="field"><label for="f-date">Date (event day or deadline) <span class="req" aria-hidden="true">*</span></label><input id="f-date" name="event_date" type="date" required /><p class="err" id="e-event_date"></p></div>
          </div>
          <div class="row">
            <div class="field"><label for="f-type">Type of work <span class="req" aria-hidden="true">*</span></label>
              <select id="f-type" name="event_type" required><option value="">Choose one</option>{eventTypes.map((t) => <option>{t}</option>)}</select><p class="err" id="e-event_type"></p></div>
            <div class="field"><label for="f-service">Service needed <span class="req" aria-hidden="true">*</span></label>
              <select id="f-service" name="service" required><option value="">Choose one</option>{serviceOptions.map((t) => <option>{t}</option>)}</select><p class="err" id="e-service"></p></div>
          </div>
          <div class="row">
            <div class="field"><label for="f-venue">Venue or city <span class="req" aria-hidden="true">*</span></label><input id="f-venue" name="venue" required placeholder="Remote is fine for voice work" /><p class="err" id="e-venue"></p></div>
            <div class="field"><label for="f-aud">Expected audience <span class="opt">(optional)</span></label>
              <select id="f-aud" name="audience_size"><option value="">Not sure</option>{audience.map((t) => <option>{t}</option>)}</select></div>
          </div>
          <div class="row">
            <div class="field"><label for="f-lang">Languages required <span class="opt">(optional)</span></label><input id="f-lang" name="languages" placeholder="e.g. English" /></div>
            {site.form.showBudget && (
              <div class="field"><label for="f-budget">Budget range <span class="opt">(optional)</span></label>
                <select id="f-budget" name="budget"><option value="">Prefer not to say</option>{site.form.budgetBands.map((b) => <option>{b}</option>)}</select></div>
            )}
          </div>
          <div class="field"><label for="f-brief">Brief <span class="opt">(optional)</span></label><textarea id="f-brief" name="brief" rows="5" maxlength="2000" aria-describedby="h-brief"></textarea><p class="hint" id="h-brief">Audience, objectives, programme length or script length, other speakers: anything that helps.</p></div>
        </fieldset>

        <div class="field consent">
          <input id="f-consent" name="consent" type="checkbox" required />
          <label for="f-consent">I agree that the details above can be used to respond to this enquiry, as described in the <a href="/privacy/" class="text-link">privacy notice</a>. <span class="req" aria-hidden="true">*</span></label>
          <p class="err" id="e-consent"></p>
        </div>

        <div class="submit-row">
          <button type="submit" class="btn btn--primary">Send enquiry</button>
          <p class="hint">{mode === 'mailto' ? 'This opens your email app with the enquiry written out. Nothing is sent until you press send there.' : 'Fields marked * are required.'}</p>
        </div>
        <div class="result" role="status" aria-live="polite" tabindex="-1" data-result hidden></div>
      </form>

      <aside class="next stage grain">
        <h2 class="h3">What happens next</h2>
        <ol>
          <li><strong>Availability.</strong> I check the date and reply to you directly.</li>
          <li><strong>A short call.</strong> To understand your audience, objectives and programme or script.</li>
          <li><strong>A proposal.</strong> Scope, preparation and terms for your project.</li>
        </ol>
        <p class="muted small">Programme bookings and interviews through media houses may be subject to my broadcasting commitments and employer policy.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .booking-hero { padding-top: calc(var(--header-h) + 4rem); padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
  .backdrop :global(img) { object-position: 50% 0; }
  .bh { position: relative; z-index: 2; display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 900px) { .bh { grid-template-columns: 1.5fr 1fr; } }
  .bh .h1 { margin-top: 1rem; max-width: 13ch; }
  .bh .lede { color: rgba(255,243,246,.85); margin-top: 1rem; }
  .bh-cut { position: absolute; z-index: 1; right: 24%; bottom: 0; width: min(19vw, 280px); opacity: .9; }
  .bh-cut :global(img) { width: 100%; -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent); mask-image: linear-gradient(180deg, #000 70%, transparent); filter: drop-shadow(0 0 30px rgba(255,92,147,.35)); }
  @media (max-width: 899px) { .bh-cut { display: none; } }
  .direct { display: grid; gap: .5rem; justify-items: start; padding: 1.6rem; border-radius: var(--r-lg); background: rgba(34,16,58,.6); border: 1px solid var(--stage-line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .d-head { color: var(--copper); font-weight: 700; }
  .d-line { font-family: var(--font-display); font-size: var(--step-2); font-weight: 650; text-decoration: none; letter-spacing: -0.03em; overflow-wrap: anywhere; }
  .d-line.mail { font-size: var(--step-1); }
  .d-line:hover { color: var(--copper); }

  .form-grid { display: grid; gap: 3rem; }
  @media (min-width: 1000px) { .form-grid { grid-template-columns: 1.7fr 1fr; align-items: start; gap: 4rem; } }
  .booking { display: grid; gap: 2.5rem; padding: clamp(1.4rem, 1rem + 2vw, 2.6rem); border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  fieldset { border: 0; padding: 0; display: grid; gap: .75rem; min-width: 0; }
  legend { font-family: var(--font-display); font-size: var(--step-2); font-weight: 650; letter-spacing: -0.03em; margin-bottom: 1rem; padding: 0; }
  .row { display: grid; gap: .75rem 1.25rem; }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: .45rem; align-content: start; }
  label { font-weight: 700; font-size: .92rem; }
  .req { color: var(--copper); }
  .opt { font-weight: 500; color: var(--text-2); }
  input:not([type='checkbox']), select, textarea { width: 100%; min-height: 52px; padding: .75em 1em; border: 1.5px solid var(--line); border-radius: var(--r-sm); background: var(--bg); color: var(--text); transition: border-color .2s, box-shadow .2s; }
  textarea { resize: vertical; min-height: 140px; }
  input:hover, select:hover, textarea:hover { border-color: var(--text-2); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; border-color: var(--focus); box-shadow: 0 0 0 4px color-mix(in srgb, var(--focus) 30%, transparent); }
  [aria-invalid='true'] { border-color: #D93A2F !important; }
  .err { color: #D93A2F; font-size: .85rem; font-weight: 700; min-height: 1.3em; line-height: 1.3; margin-top: -2px; }
  :global([data-theme='dark']) .err { color: #FF8A80; }
  :global([data-theme='dark']) [aria-invalid='true'] { border-color: #FF8A80 !important; }
  .hint { font-size: .86rem; color: var(--text-2); }
  .consent { grid-template-columns: auto 1fr; align-items: start; column-gap: .8rem; }
  .consent input { width: 22px; height: 22px; margin-top: .15em; accent-color: var(--copper); }
  .consent label { font-weight: 500; }
  .consent .err { grid-column: 2; }
  .submit-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .submit-row .hint { max-width: 44ch; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .result { padding: 1.4rem; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--bg); display: grid; gap: .8rem; }
  .result.ok { border-left: 4px solid #2EA36B; }
  .result.bad { border-left: 4px solid #D93A2F; }
  .result h3 { font-size: var(--step-1); }
  .result pre { white-space: pre-wrap; font-family: var(--font-body); font-size: .85rem; background: var(--bg-2); padding: 1rem; border-radius: var(--r-sm); max-height: 240px; overflow: auto; }
  .next { position: sticky; top: calc(var(--header-h) + 1.5rem); padding: 2rem; border-radius: var(--r-lg); display: grid; gap: 1.2rem; overflow: hidden; }
  .next ol { padding-left: 1.2em; display: grid; gap: .8rem; color: var(--mist); }
  .next strong { color: var(--ivory); }
  .next .muted { color: var(--mist); }
  .small { font-size: var(--step--1); }
  .sign { font-size: var(--step-2); color: var(--gold); line-height: 1.15; }
</style>

<script>
  const form = document.getElementById('booking') as HTMLFormElement;
  const result = form.querySelector<HTMLElement>('[data-result]')!;
  const loadedAt = Date.now();

  // Prefill service from ?service= and block past dates.
  const params = new URLSearchParams(location.search);
  const svc = params.get('service');
  const select = form.querySelector<HTMLSelectElement>('#f-service')!;
  if (svc && [...select.options].some((o) => o.value === svc)) select.value = svc;
  const today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  const dateInput = form.querySelector<HTMLInputElement>('#f-date')!;
  dateInput.min = today.toISOString().slice(0, 10);

  const messages: Record<string, string> = {
    name: 'Please enter your name.', organisation: 'Please enter your organisation.',
    email: 'Please enter a valid email address.', phone: 'Please enter a phone number, including the country code.',
    event_name: 'Please name the project or event.', event_date: 'Please choose a date that is today or later.',
    event_type: 'Please choose the type of work.', service: 'Please choose a service.', venue: 'Please enter the venue or city.',
    consent: 'Please confirm we can use these details to reply.',
  };

  function check(el: HTMLInputElement | HTMLSelectElement): boolean {
      const name = el.name;
      const err = form.querySelector<HTMLElement>(`#e-${name}`);
      let ok = el.checkValidity();
      if (el instanceof HTMLInputElement && el.type === 'text' && el.value.trim() === '') ok = false;
      if (name !== 'consent' && 'value' in el && el.value.trim() === '') ok = false;
      el.setAttribute('aria-invalid', String(!ok));
      if (err) { err.textContent = ok ? '' : messages[name] || 'Please check this field.'; if (!ok) el.setAttribute('aria-describedby', err.id); }
      return ok;
  }
  function validate(): HTMLElement | null {
    let first: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((el) => { if (!check(el) && !first) first = el; });
    return first;
  }
  // Re-check a field the visitor has corrected; error lines reserve their space so nothing jumps.
  form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]').forEach((el) => {
    const recheck = () => { if (el.getAttribute('aria-invalid') === 'true') check(el); };
    el.addEventListener('blur', recheck); el.addEventListener('change', recheck);
  });

  function summary(data: FormData) {
    const rows: [string, string][] = [
      ['Name', 'name'], ['Organisation', 'organisation'], ['Email', 'email'], ['Telephone', 'phone'],
      ['Project or event', 'event_name'], ['Date', 'event_date'], ['Type of work', 'event_type'], ['Service', 'service'],
      ['Venue', 'venue'], ['Audience', 'audience_size'], ['Languages', 'languages'], ['Budget', 'budget'], ['Brief', 'brief'],
    ];
    return rows.map(([label, key]) => [label, String(data.get(key) || '').trim()] as const).filter(([, v]) => v).map(([l, v]) => `${l}: ${v}`).join('\n');
  }
  function show(kind: 'ok' | 'bad', html: string) {
    result.hidden = false; result.className = `result ${kind}`; result.innerHTML = html; result.focus();
  }
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    result.hidden = true;
    const bad = validate();
    if (bad) { bad.focus(); return; }
    const data = new FormData(form);
    // Spam guards: honeypot filled or submitted implausibly fast.
    if (String(data.get('company_website') || '') !== '' || Date.now() - loadedAt < 2500) {
      show('bad', '<h3>Please try again</h3><p>Something went wrong. Wait a moment and submit again, or email directly.</p>');
      return;
    }
    const mode = form.dataset.mode;
    const email = form.dataset.email!;
    const text = summary(data);
    const subject = `Booking enquiry: ${data.get('event_name')} (${data.get('event_date')})`;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    if (mode === 'mailto') {
      const href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text + '\n\nSent from the enquiry form on my website')}`;
      window.location.href = href;
      show('ok', `<h3>Your email app should now be open</h3><p>Your enquiry is written out and addressed to me at ${esc(email)}. <strong>It is not sent until you press send in your email app.</strong></p><p>If nothing opened, copy the text below into an email to <a class="text-link" href="mailto:${esc(email)}">${esc(email)}</a>.</p><pre>${esc(text)}</pre><button type="button" class="btn btn--ghost" data-copy-enquiry>Copy enquiry</button>`);
      result.querySelector('[data-copy-enquiry]')?.addEventListener('click', async (ev) => {
        const b = ev.currentTarget as HTMLButtonElement;
        try { await navigator.clipboard.writeText(`${subject}\n\n${text}`); b.textContent = 'Copied'; } catch { b.textContent = 'Select the text above to copy'; }
      });
      return;
    }

    btn.disabled = true; const label = btn.textContent; btn.textContent = 'Sending…';
    try {
      let res: Response;
      if (mode === 'netlify') {
        res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data as any).toString() });
      } else {
        const payload = Object.fromEntries([...data.entries()].filter(([k]) => k !== 'company_website' && k !== 'form-name'));
        res = await fetch(form.dataset.endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ ...payload, _subject: subject }) });
      }
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show('ok', '<h3>Thank you, your enquiry has been sent</h3><p>I will reply to the email address you provided.</p>');
    } catch {
      show('bad', `<h3>Your enquiry was not sent</h3><p>Please try again, or email <a class="text-link" href="mailto:${esc(email)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}">${esc(email)}</a> directly. Your details are still in the form.</p>`);
    } finally {
      btn.disabled = false; btn.textContent = label;
    }
  });
</script>
