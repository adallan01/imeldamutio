---
import { Image } from 'astro:assets';
import { stages } from '../lib/photos';
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/on-air/', label: 'On air' },
  { href: '/work/', label: 'Gallery' },
  { href: '/media-kit/', label: 'Media kit' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Imelda Mutio, home">
      <span class="wm">Imelda Mutio</span><span class="spot" aria-hidden="true"></span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>{nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="actions">
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </button>
      <a href="/contact/" class="btn btn--primary cta">Book me</a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="sr-only">Menu</span><span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <div id="menu" class="menu" hidden data-menu>
    <div class="menu-bg" aria-hidden="true"><Image src={stages.spotlight} alt="" widths={[600, 1000]} sizes="100vw" loading="lazy" /></div>
    <nav class="wrap menu-inner" aria-label="Mobile">
      <ul>
        <li style="--i:0"><a href="/">Home</a></li>
        {nav.map((n, i) => <li style={`--i:${i + 1}`}><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <a href="/contact/" class="btn btn--primary">Enquire about availability</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 60; color: var(--ivory); transition: background-color .35s var(--ease), backdrop-filter .35s, border-color .35s; border-bottom: 1px solid transparent; }
  .site-header.is-scrolled { background: rgba(5, 11, 28, .78); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); border-bottom-color: var(--stage-line); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: baseline; gap: .15rem; text-decoration: none; margin-right: auto; }
  .wm { font-family: var(--font-display); font-weight: 650; font-size: 1.28rem; letter-spacing: -0.035em; }
  .spot { width: .45rem; height: .45rem; border-radius: 50%; background: var(--copper); box-shadow: 0 0 12px 2px rgba(240,120,50,.8); transform: translateY(-.05rem); }
  .nav ul { list-style: none; padding: 0; display: flex; gap: clamp(.9rem, 1.6vw, 2rem); }
  .nav a { position: relative; text-decoration: none; font-weight: 650; font-size: .93rem; color: rgba(238,241,248,.78); padding-block: .5rem; transition: color .2s; }
  .nav a::after { content: ''; position: absolute; left: 50%; bottom: -2px; width: 6px; height: 6px; border-radius: 50%; background: var(--copper); transform: translateX(-50%) scale(0); transition: transform .3s var(--ease-out); box-shadow: 0 0 10px var(--copper); }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--ivory); }
  .nav a:hover::after, .nav a[aria-current='page']::after { transform: translateX(-50%) scale(1); }
  .actions { display: flex; align-items: center; gap: .6rem; }
  .icon-btn { border-color: var(--stage-line); color: var(--ivory); }
  .cta { min-height: 46px; padding: .6em 1.3em; }
  .theme-btn .moon { display: none; }
  :global([data-theme='dark']) .theme-btn .sun { display: none; }
  :global([data-theme='dark']) .theme-btn .moon { display: block; }
  .menu-btn { display: none; }
  .burger { display: grid; gap: 6px; width: 18px; }
  .burger span { height: 1.6px; background: currentColor; transition: transform .3s var(--ease-out); }
  .menu-btn[aria-expanded='true'] .burger span:first-child { transform: translateY(3.8px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .burger span:last-child { transform: translateY(-3.8px) rotate(-45deg); }

  .menu { position: fixed; inset: var(--header-h) 0 0 0; background: var(--stage); overflow-y: auto; }
  .menu-bg { position: absolute; inset: 0; opacity: .55; }
  .menu-bg img { width: 100%; height: 100%; object-fit: cover; }
  .menu-inner { position: relative; padding-block: 2rem 3rem; display: grid; gap: 2rem; }
  .menu ul { list-style: none; padding: 0; }
  .menu li { animation: rise .6s var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
  .menu li a { display: block; font-family: var(--font-display); font-size: clamp(2.1rem, 9vw, 3.4rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1.15; text-decoration: none; color: var(--ivory); }
  .menu li a[aria-current='page'] { color: var(--copper); }
  .menu .btn { justify-self: start; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1100px) { .nav { display: none; } .menu-btn { display: inline-grid; } }
  @media (max-width: 520px) { .cta { display: none; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 30 || !menu.hidden);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  const setMenu = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : ''; onScroll();
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
  };
  btn.addEventListener('click', () => { const open = btn.getAttribute('aria-expanded') !== 'true'; setMenu(open); if (!open) btn.focus(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); btn.focus(); } });
  window.matchMedia('(min-width: 1101px)').addEventListener('change', (e) => e.matches && setMenu(false));

  // Light / dark mode. Defaults to the visitor's system setting; a choice is remembered.
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const current = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const label = () => { const t = current(); root.dataset.theme = t; toggle.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'); };
  label();
  toggle.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {}
    label();
  });
</script>
