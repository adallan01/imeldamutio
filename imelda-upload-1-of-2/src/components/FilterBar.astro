---
/** Filter chips (and optional search) for any list whose items carry data-category / data-search. */
interface Props { target: string; categories: string[]; search?: boolean; label: string; noun?: string }
const { target, categories, search = false, label, noun = 'items' } = Astro.props;
---
<div class="filterbar" data-filterbar data-target={target} data-noun={noun}>
  {search && (
    <div class="search">
      <label for={`search-${target}`} class="sr-only">Search {noun}</label>
      <input id={`search-${target}`} type="search" placeholder={`Search ${noun}…`} data-search-input autocomplete="off" />
    </div>
  )}
  <div class="chips" role="group" aria-label={label}>
    <button type="button" class="chip" aria-pressed="true" data-value="all">All</button>
    {categories.map((c) => <button type="button" class="chip" aria-pressed="false" data-value={c}>{c}</button>)}
  </div>
  <p class="status muted" aria-live="polite" data-status></p>
</div>
<style>
  .filterbar { display: grid; gap: 1rem; margin-bottom: 2rem; }
  .search input { width: 100%; max-width: 440px; min-height: 52px; padding: .75em 1.2em; border: 1.5px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--text); }
  .search input:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .status { font-size: var(--step--1); min-height: 1.4em; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-filterbar]').forEach((bar) => {
    const list = document.getElementById(bar.dataset.target!);
    if (!list) return;
    const items = ([...list.children] as HTMLElement[]).filter((el) => el.dataset.category);
    const chips = [...bar.querySelectorAll<HTMLButtonElement>('.chip')];
    const input = bar.querySelector<HTMLInputElement>('[data-search-input]');
    const status = bar.querySelector<HTMLElement>('[data-status]');
    const empty = list.parentElement?.querySelector<HTMLElement>('[data-empty]');
    let cat = 'all';
    const apply = () => {
      const q = (input?.value || '').trim().toLowerCase();
      let shown = 0;
      items.forEach((el) => {
        const okCat = cat === 'all' || el.dataset.category === cat;
        const okQ = !q || (el.dataset.search || el.textContent || '').toLowerCase().includes(q);
        const show = okCat && okQ;
        el.hidden = !show;
        if (show) shown++;
      });
      if (status) status.textContent = `Showing ${shown} of ${items.length} ${bar.dataset.noun}`;
      if (empty) empty.hidden = shown > 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      cat = c.dataset.value!;
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      apply();
    }));
    input?.addEventListener('input', apply);
    apply();
  });
</script>
