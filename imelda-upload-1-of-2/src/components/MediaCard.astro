---
import { kindOf, soft, type Entry } from '../lib/data';
interface Props { item: Entry }
const { item } = Astro.props;
const kind = kindOf(item);
const isVideo = Boolean(item.youtubeId);
const action = item.format === 'audio-link' ? 'Listen' : isVideo ? 'Play' : 'Read';
let host = ''; try { host = new URL(item.url).hostname.replace(/^www\./, ''); } catch {}
---
<article class="mcard">
  <div class="top">
    <span class={`badge ${kind.cls}`}>{kind.label}</span>
    <span class="date">{item.displayDate}</span>
  </div>
  <h3 class="title">{soft(item.title)}</h3>
  <p class="src">{item.publisher}</p>
  <p class="sum">{item.summary}</p>
  <p class="role"><span>My role</span> {item.role}</p>
  {isVideo
    ? <button type="button" class="go" data-video={item.youtubeId} data-video-title={item.title}>{action} video</button>
    : <a class="go" href={item.url} target="_blank" rel="noopener">{action} at {host}<span class="sr-only">: {item.title} (opens in a new tab)</span></a>}
</article>
<style>
  .mcard { height: 100%; display: flex; flex-direction: column; gap: .7rem; padding: 1.6rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); transition: transform .4s var(--ease-out), box-shadow .4s, border-color .3s; }
  .mcard:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: transparent; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .date { font-size: var(--step--1); color: var(--text-2); font-weight: 600; }
  .title { font-size: var(--step-1); line-height: 1.2; letter-spacing: -0.02em; }
  .src { font-size: var(--step--1); font-weight: 700; color: var(--link); }
  .sum { color: var(--text-2); font-size: .96rem; }
  .role { margin-top: auto; padding-top: .8rem; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--text-2); }
  .role span { font-weight: 700; color: var(--text); margin-right: .3rem; }
  .go { all: unset; cursor: pointer; display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 600; color: var(--text); text-decoration: none; background: linear-gradient(var(--copper), var(--copper)) 0 85% / 0 2px no-repeat; transition: background-size .35s var(--ease-out); }
  .go:hover { background-size: 100% 2px; }
  .go:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
</style>
