---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../lib/data';
const mode = site.form.mode;
---
<Base title="Privacy Notice" description="How enquiries made through Imelda Mutio's website are handled, in line with Kenya's Data Protection Act, 2019.">
  <PageHero kicker="Privacy" title="Privacy notice" stage="brick" />
  <section class="room section">
    <div class="wrap prose">
            <p class="muted">Last updated: {new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
      <h2 class="h3">What I collect</h2>
      <p>When you send a booking enquiry, I receive the details you enter: your name, organisation, email, telephone number and information about your event.</p>
      <h2 class="h3">How it is sent</h2>
      {mode === 'mailto'
        ? <p>The enquiry form prepares an email in your own email app, addressed to {site.contact.email}. Nothing is transmitted by this website; your email provider sends the message when you press send.</p>
        : <p>The enquiry form sends your details securely to a form-handling service that forwards them to my booking inbox.</p>}
      <h2 class="h3">How it is used</h2>
      <p>I use your details only to respond to your enquiry, prepare a proposal and arrange the engagement. I never sell them or share them for marketing.</p>
      <h2 class="h3">Retention and your rights</h2>
      <p>I keep enquiries only as long as needed to manage the enquiry and any resulting engagement. In line with Kenya's Data Protection Act, 2019, you can ask to see, correct or delete your details by writing to <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
      <h2 class="h3">Cookies and embedded media</h2>
      <p>This website does not use analytics or advertising cookies, and it does not embed third-party video players. Links to news sites and social platforms take you to services with their own policies.</p>
    </div>
  </section>
</Base>
<style>.prose h2 { margin-top: 2rem; margin-bottom: .5rem; } .prose h1 { margin-block: .8rem 1rem; }</style>
