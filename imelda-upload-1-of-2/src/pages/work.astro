---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../lib/data';
import { photos, type PhotoKey } from '../lib/photos';

const gallery: { key: PhotoKey; cap: string }[] = [
  { key: 'timer-coat', cap: 'Five minutes on the clock' },
  { key: 'studio-mic', cap: 'In the studio' },
  { key: 'portrait-green', cap: 'Portrait' },
  { key: 'family-fest', cap: 'Festival stage' },
  { key: 'speaking-orange', cap: 'Hosting' },
  { key: 'crowd-orange', cap: 'With the audience' },
  { key: 'stage-trio', cap: 'On stage with guests' },
  { key: 'room-orange', cap: 'Leading a session' },
];
const ig = site.social.find((x) => x.label === 'Instagram');
---
<Base title="Gallery" description="Photographs of Imelda Mutio hosting live events and presenting on radio: corporate sessions, panels, festival stages and the studio.">
  <PageHero kicker="Gallery" title="See me in action." lede="On stage, with the audience and in the studio." stage="sparkle" cutout="coat" word="LIVE" />

  <section class="room section" aria-labelledby="ph-h">
    <div class="wrap">
      <div class="head head--split">
        <div><p class="kicker">Photographs</p><h2 id="ph-h" class="h1" data-split>In the room and on the mic.</h2></div>
        <p class="lede">Select a photo to view it full size.</p>
      </div>
      <ul class="gallery">
        {gallery.map((g, i) => (
          <li class={`g g${i}`}>
            <button type="button" class="g-btn" data-lightbox={i} aria-label={`View larger: ${photos[g.key].alt}`}>
              <Image src={photos[g.key].src} alt={photos[g.key].alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 46vw" style={`object-position:${photos[g.key].pos}`} loading="lazy" />
              <span class="g-cap">{g.cap}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {ig && (
    <section class="stage melt section grain clips" aria-labelledby="clips-h">
      <div class="beams" aria-hidden="true"></div>
      <div class="wrap clips-in">
        <div><p class="kicker">Clips</p><h2 id="clips-h" class="h2" data-split>Hear me on air.</h2>
        <p class="muted">Short clips from the show, including the Dilemma of the Day, are on my Instagram.</p></div>
        <a class="btn btn--primary" href={ig.url} target="_blank" rel="me noopener">Watch on Instagram<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </section>
  )}

  <dialog class="lightbox" data-lb aria-label="Photo viewer">
    {gallery.map((g, i) => (
      <figure class="lb-fig" data-lb-fig={i} hidden>
        <Image src={photos[g.key].src} alt={photos[g.key].alt} widths={[1000, 1600]} sizes="92vw" loading="lazy" />
        <figcaption>{g.cap}</figcaption>
      </figure>
    ))}
    <div class="lb-ctrls">
      <button type="button" class="icon-btn" data-lb-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="icon-btn" data-lb-next aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="btn btn--primary" data-lb-close>Close</button>
    </div>
  </dialog>
</Base>
<style>
  .clips-in { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; justify-content: space-between; }
  .clips-in > div { display: grid; gap: .7rem; max-width: 52ch; }
  .clips-in .muted { color: var(--mist); }
  .gallery { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .g0 { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .gallery { grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(220px, 19vw, 300px); grid-auto-flow: dense; }
    .g0 { grid-column: span 2; grid-row: span 2; }
    .g3 { grid-row: span 2; }
    .g6 { grid-column: span 2; }
  }
  .g-btn { all: unset; cursor: zoom-in; position: relative; display: block; width: 100%; height: 100%; min-height: 220px; border-radius: var(--r-md); overflow: hidden; background: var(--stage); }
  @media (max-width: 899px) { .g-btn { aspect-ratio: 4 / 5; min-height: 0; } .g0 .g-btn { aspect-ratio: 3 / 2; } }
  .g-btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .g-btn :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .g-btn:hover :global(img) { transform: scale(1.06); }
  .g-cap { position: absolute; left: .8rem; bottom: .8rem; padding: .3em .8em; border-radius: 999px; background: rgba(5,11,28,.82); color: var(--ivory); font-size: .8rem; font-weight: 700; }
  .lightbox { width: min(1100px, 94vw); max-height: 94vh; border: 0; padding: 1rem; border-radius: var(--r-lg); background: var(--stage); color: var(--ivory); }
  .lightbox::backdrop { background: rgba(3,7,18,.9); backdrop-filter: blur(6px); }
  .lb-fig :global(img) { width: 100%; max-height: 76vh; object-fit: contain; border-radius: var(--r-md); }
  .lb-fig figcaption { margin-top: .6rem; color: var(--mist); font-size: .9rem; }
  .lb-ctrls { display: flex; gap: .6rem; justify-content: flex-end; align-items: center; margin-top: .8rem; }
  .lb-ctrls .icon-btn { color: var(--ivory); border-color: var(--stage-line); }
</style>
<script>
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const figs = [...lb.querySelectorAll<HTMLElement>('[data-lb-fig]')];
  let cur = 0, opener: HTMLElement | null = null;
  const show = (n: number) => { cur = (n + figs.length) % figs.length; figs.forEach((f, i) => (f.hidden = i !== cur)); };
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) => b.addEventListener('click', () => { opener = b; show(Number(b.dataset.lightbox)); lb.showModal(); }));
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(cur - 1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(cur + 1));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(cur + 1); if (e.key === 'ArrowLeft') show(cur - 1); });
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('close', () => opener?.focus());
</script>
