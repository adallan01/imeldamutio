---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroActs from '../components/HeroActs.astro';
import Rail from '../components/Rail.astro';
import Marquee from '../components/Marquee.astro';
import ToneImage from '../components/ToneImage.astro';
import { site, services, shows, featuredMedia } from '../lib/data';
import { photos, stages, duo, type PhotoKey } from '../lib/photos';

const strengths: { key: string; title: string; text: string; photo: PhotoKey }[] = [
  { key: 'relatable', title: 'Relatable', text: 'I connect easily with different audiences. On radio I talk with listeners every day, and I bring that same easy warmth to your room.', photo: 'crowd-orange' },
  { key: 'engaging', title: 'Engaging', text: 'I keep audiences informed, entertained and involved: asking, listening and bringing people into the conversation.', photo: 'stage-trio' },
  { key: 'versatile', title: 'Versatile', text: 'From the radio studio to corporate sessions, workshops and festival stages, I adapt to the room I am in.', photo: 'family-fest' },
  { key: 'professional', title: 'Professional', text: 'Reliable, well prepared and adaptable. Live radio taught me to think on my feet and keep things moving when plans change.', photo: 'speaking-orange' },
];
const onRadio = ['Present and link live segments', 'Interview guests and personalities', 'Engage listeners through conversation and interactive features', 'Tell stories and create relatable on-air moments', 'Think quickly and respond naturally, live'];
const moments: { key: PhotoKey; cap: string; label: string }[] = [
  { key: 'crowd-orange', label: 'Hosting', cap: 'Out among the audience, mic in hand' },
  { key: 'stage-trio', label: 'On stage', cap: 'Bringing guests into the conversation' },
  { key: 'family-fest', label: 'Festival', cap: 'An outdoor stage with a live band' },
];
const show = shows[0];
const press = featuredMedia[0];
---
<Base title="Imelda Mutio">
  <HeroActs />

  <Marquee words={['Radio presenter', 'MC', 'Event host', 'Interviewer', 'Voice-over', 'Storyteller']} />

  <!-- WHY ME: a spotlight moves from strength to strength -->
  <section class="room section why has-sbg" aria-labelledby="why-h" data-why>
    <div class="sbg" aria-hidden="true"><Image src={stages.spotlight} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" style="object-position:50% 10%" /></div>
    <div class="wrap why-grid">
      <div class="why-copy">
        <p class="kicker reveal">Why organisers book me</p>
        <h2 id="why-h" class="h1" data-split>A strong host does more than hold a <span class="serif">microphone.</span></h2>
        <p class="lede reveal" style="--d:.15s">It's about reading the room, keeping the programme moving and making people feel included. That's what I do, on air every weekday and on stage at your event.</p>
        <div class="strengths" role="group" aria-label="My strengths">
          {strengths.map((s, i) => (
            <button type="button" class="strength" style={`--n:${i}`} aria-pressed={i === 0 ? 'true' : 'false'} data-strength={s.key}>
              <span class="lamp" aria-hidden="true"></span>
              <span class="st-title">{s.title}</span>
              <span class="st-text">{s.text}</span>
              <span class="st-prog" aria-hidden="true"><span></span></span>
            </button>
          ))}
        </div>
      </div>
      <div class="why-media" aria-hidden="true">
        {strengths.map((s, i) => (
          <figure class:list={['why-fig', { 'is-on': i === 0 }]} data-fig={s.key}>
            <Image src={photos[s.photo].src} alt="" widths={[500, 800, 1100]} sizes="(min-width: 960px) 42vw, 92vw" style={`object-position:${photos[s.photo].pos}`} loading="lazy" />
          </figure>
        ))}
        <span class="iris" aria-hidden="true"></span>
        <p class="quote serif">“Good conversations. Great audiences. Real impact.”</p>
      </div>
    </div>
  </section>

  <!-- SERVICES RAIL: my photos on the cards -->
  <section class="room-2 section rail-sec has-sbg" aria-labelledby="svc-h">
    <div class="sbg" aria-hidden="true" style="--veil:86%"><Image src={stages['event-hall']} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" /></div>
    <Rail label="Services" id="svc-rail">
      <div slot="head" class="rail-head">
        <p class="kicker reveal">Services</p>
        <h2 id="svc-h" class="h1" data-split>Pick the format. <span class="muted">I'll own the room.</span></h2>
      </div>
      {services.map((s, i) => {
        const p = photos[s.photo as PhotoKey];
        return (
          <li class="svc reveal" style={`--d:${i * 0.08}s`}>
            <a href={`/services/#${s.id}`} class="svc-link tone-host">
              <ToneImage src={p.src} duo={duo[s.photo]} alt={p.alt} widths={[420, 700, 900]} sizes="(min-width: 900px) 380px, 80vw" pos={p.pos} />
              <span class="svc-body">
                <span class="svc-name">{s.name}</span>
                <span class="svc-short">{s.short}</span>
                <span class="svc-go">Explore <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </span>
            </a>
          </li>
        );
      })}
    </Rail>
  </section>

  <!-- ON AIR: the show, in my own words -->
  <section class="stage melt section onair" aria-labelledby="air-h">
    <div class="sbg" aria-hidden="true" style="--veil:35%"><Image src={stages.sparkle} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" /></div>
    <div class="wrap air-grid">
      <div class="air-photo tone-host reveal">
        <ToneImage src={photos['studio-mic'].src} duo={duo['studio-mic']} alt={photos['studio-mic'].alt} widths={[500, 800, 1100]} sizes="(min-width: 960px) 40vw, 92vw" pos={photos['studio-mic'].pos} />
        <span class="live" aria-hidden="true"><i></i>On air</span>
      </div>
      <div class="air-copy">
        <p class="kicker reveal">On air</p>
        <h2 id="air-h" class="h1" data-split>Live on weekday radio.</h2>
        {show && <p class="air-show reveal" style="--d:.1s"><strong>{show.title}</strong><span>{show.displayDate}</span></p>}
        <p class="lede reveal" style="--d:.15s">On radio I combine music, personality and conversation. My style is conversational, upbeat and audience-focused, so listeners feel part of the show.</p>
        <ul class="air-list">{onRadio.map((r, i) => <li class="reveal" style={`--d:${0.2 + i * 0.06}s`}>{r}</li>)}</ul>
        <div class="dilemma reveal" style="--d:.3s">
          <p class="d-k">Daily feature</p>
          <p class="d-t">Dilemma of the Day</p>
          <p class="d-x">One question, two hard choices, and the whole of Nairobi weighing in.</p>
        </div>
        <div class="btn-row reveal" style="--d:.35s">
          <a href="/on-air/" class="btn btn--glass">More about the show</a>
          {press && <a href={press.url} target="_blank" rel="noopener" class="text-link on-dark">As covered by {press.publisher}<span class="sr-only"> (opens in a new tab)</span></a>}
        </div>
      </div>
    </div>
  </section>

  <!-- LIVE MOMENTS: real photos -->
  <section class="room section has-sbg" aria-labelledby="mom-h">
    <div class="sbg" aria-hidden="true" style="--veil:84%"><Image src={stages.gala} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" style="object-position:50% 90%" /></div>
    <div class="wrap">
      <div class="head head--split">
        <div>
          <p class="kicker reveal">Off air</p>
          <h2 id="mom-h" class="h1" data-split>Selected live moments.</h2>
        </div>
        <p class="lede reveal" style="--d:.1s">I bring the confidence and spontaneity of live radio into event spaces: connecting with audiences, guiding the programme and keeping the room engaged.</p>
      </div>
      <ul class="tiles">
        {moments.map((m, i) => (
          <li class="tile tone-host reveal" style={`--d:${i * 0.12}s`}>
            <ToneImage src={photos[m.key].src} duo={duo[m.key]} alt={photos[m.key].alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 33vw, 92vw" pos={photos[m.key].pos} />
            <div class="tile-body">
              <span class="badge badge--booking">{m.label}</span>
              <h3>{m.cap}</h3>
            </div>
          </li>
        ))}
      </ul>
      <p class="after reveal"><a href="/work/" class="text-link">See the gallery</a></p>
    </div>
  </section>

  {site.testimonials.length > 0 && (
    <section class="room-2 section" aria-labelledby="t-h">
      <div class="wrap"><h2 id="t-h" class="h1">From the organisers.</h2>
        <div class="grid grid--3">{site.testimonials.map((t: any) => <blockquote class="tq"><p class="serif">“{t.quote}”</p><footer>{t.name}, {t.role}, {t.organisation}</footer></blockquote>)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  /* ---------- Why me ---------- */
  .why-grid { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 5rem); align-items: center; }
  @media (min-width: 960px) { .why-grid { grid-template-columns: 1.05fr 1fr; } }
  .why-copy { display: grid; gap: 1.3rem; }
  .why-copy .serif { color: var(--accent-text); font-weight: 400; }
  .strengths { display: grid; margin-top: .8rem; border-top: 1px solid var(--line); }
  .strength { all: unset; cursor: pointer; position: relative; display: grid; gap: .45rem; padding: 1.25rem 0 1.35rem 2.1rem; border-bottom: 1px solid var(--line); }
  .strength:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .lamp { position: absolute; left: 0; top: 1.55rem; width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--text-2); transition: background-color .4s, border-color .4s, box-shadow .6s; }
  .strength[aria-pressed='true'] .lamp { background: var(--copper); border-color: var(--copper); box-shadow: 0 0 0 6px rgba(240,120,50,.15), 0 0 24px 4px rgba(240,120,50,.7); }
  .st-title { font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); letter-spacing: -0.03em; color: var(--text-2); transition: color .4s;
    background: linear-gradient(100deg, currentColor 40%, var(--copper) 50%, currentColor 60%) 200% 0 / 300% 100% no-repeat; -webkit-background-clip: text; background-clip: text; }
  .strength[aria-pressed='true'] .st-title, .strength:hover .st-title { color: var(--text); }
  .st-text { color: var(--text-2); max-width: 52ch; }
  .js .st-text { max-height: 0; opacity: 0; overflow: hidden; transform: translateY(-6px); transition: max-height .6s var(--ease-out), opacity .5s, transform .6s var(--ease-out); }
  .js .strength[aria-pressed='true'] .st-text { max-height: 14em; opacity: 1; transform: none; }
  .st-prog { position: absolute; left: 2.1rem; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .st-prog span { display: block; height: 100%; background: var(--copper); transform: scaleX(0); transform-origin: left; }
  .why.cycling .strength[aria-pressed='true'] .st-prog span { animation: prog 5.5s linear both; }
  @keyframes prog { to { transform: scaleX(1); } }

  /* Entrance: rows slide in one by one, each lamp flickers on like a stage light, a light sweeps the title. */
  .js .why .strength { opacity: 0; transform: translateX(-36px); filter: blur(6px); }
  .js .why.lit .strength { animation: row-in 1s var(--ease-out) both; animation-delay: calc(.35s + var(--n) * .22s); }
  .js .why.lit .lamp { animation: flicker 1.1s steps(1, end) both; animation-delay: calc(.6s + var(--n) * .22s); }
  .js .why.lit .st-title { animation: sweep 1.6s var(--ease) both; animation-delay: calc(.55s + var(--n) * .22s); }
  @keyframes row-in { to { opacity: 1; transform: none; filter: none; } }
  @keyframes flicker { 0% { opacity: 0; } 12% { opacity: 1; } 20% { opacity: .2; } 32% { opacity: 1; } 40% { opacity: .4; } 52%, 100% { opacity: 1; } }
  @keyframes sweep { from { background-position: 200% 0; } to { background-position: -100% 0; } }

  .why-media { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-lg); overflow: hidden; background: var(--stage); box-shadow: var(--shadow); }
  .js .why .why-media { clip-path: circle(0% at 50% 35%); }
  .js .why.lit .why-media { clip-path: circle(150% at 50% 35%); transition: clip-path 1.6s var(--ease-out) .1s; }
  .why-fig { position: absolute; inset: 0; clip-path: circle(0% at 50% 35%); transition: clip-path 1.1s var(--ease-out); }
  .why-fig.is-on { clip-path: circle(150% at 50% 35%); z-index: 1; }
  .why-fig.was-on { clip-path: circle(150% at 50% 35%); z-index: 0; transition: none; }
  .why-fig :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 6s var(--ease-out); }
  .why-fig.is-on :global(img) { transform: none; }
  .iris { position: absolute; inset: 0; z-index: 2; pointer-events: none; background: radial-gradient(circle at 50% 30%, transparent 35%, rgba(5,11,28,.55) 75%); }
  .why-media::after { content: ''; position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, transparent 50%, rgba(5,11,28,.9)); }
  .quote { position: absolute; z-index: 3; left: 1.5rem; right: 1.5rem; bottom: 1.4rem; color: var(--ivory); font-size: var(--step-2); line-height: 1.15; }

  /* ---------- Rails ---------- */
  .rail-head { display: grid; gap: .8rem; }
  .rail-head .muted { color: var(--text-2); }
  .rail-sec :global(.rail-wrap) { --card: min(78vw, 360px); }
  .svc-link { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: var(--r-lg); overflow: hidden; text-decoration: none; color: var(--ivory); background: var(--stage); isolation: isolate; box-shadow: 0 30px 60px -36px rgba(10,30,90,.9); }
  .svc-link::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(5,11,28,0) 30%, rgba(5,11,28,.6) 58%, rgba(5,11,28,.96) 100%); }
  .svc-body { position: absolute; inset: auto 0 0 0; z-index: 2; padding: 1.5rem; display: grid; gap: .55rem; }
  .svc-name { font-family: var(--font-display); font-weight: 650; font-size: var(--step-2); line-height: 1.02; letter-spacing: -0.035em; }
  .svc-short { color: rgba(238,241,248,.86); font-size: .96rem; }
  .svc-go { display: inline-flex; align-items: center; gap: .4rem; font-family: var(--font-display); font-weight: 600; color: var(--copper); margin-top: .2rem; }
  .svc-go svg { width: 1.1em; height: 1.1em; transition: transform .3s var(--ease-out); }
  .svc-link:hover .svc-go svg { transform: translateX(5px); }
  .svc-link:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  /* ---------- On air ---------- */
  .air-grid { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4.5rem); align-items: center; }
  @media (min-width: 960px) { .air-grid { grid-template-columns: .9fr 1.1fr; } }
  .air-photo { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-lg); overflow: hidden; background: var(--stage-2); box-shadow: 0 40px 100px -40px rgba(61,123,255,.55); }
  .air-photo :global(.tone) { position: absolute; inset: 0; }
  .live { position: absolute; z-index: 3; left: 1rem; top: 1rem; display: inline-flex; align-items: center; gap: .5rem; padding: .35em .9em; border-radius: 999px; background: rgba(5,11,28,.8); color: var(--ivory); font-family: var(--font-display); font-weight: 700; font-size: .82rem; }
  .live i { width: 9px; height: 9px; border-radius: 50%; background: #FF4D3D; box-shadow: 0 0 10px #FF4D3D; animation: onair 1.6s ease-in-out infinite; }
  @keyframes onair { 50% { opacity: .25; } }
  .air-copy { display: grid; gap: 1.2rem; justify-items: start; }
  .air-show { display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: baseline; font-family: var(--font-display); }
  .air-show strong { font-size: var(--step-2); letter-spacing: -0.03em; }
  .air-show span { color: var(--copper); font-weight: 700; }
  .air-copy .lede { color: rgba(238,241,248,.84); }
  .air-list { list-style: none; padding: 0; display: grid; gap: .55rem; }
  .air-list li { position: relative; padding-left: 1.6rem; color: rgba(238,241,248,.9); }
  .air-list li::before { content: ''; position: absolute; left: 0; top: .5em; width: 9px; height: 9px; border-radius: 50%; background: var(--copper); box-shadow: 0 0 10px var(--copper); }
  .dilemma { width: 100%; padding: 1.3rem 1.5rem; border-radius: var(--r-md); background: rgba(10,21,51,.6); border: 1px solid var(--stage-line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); display: grid; gap: .3rem; }
  .d-k { color: var(--copper); font-weight: 700; font-size: .85rem; }
  .d-t { font-family: var(--font-display); font-weight: 650; font-size: var(--step-2); letter-spacing: -0.03em; }
  .d-x { color: var(--mist); }
  .on-dark { color: var(--ivory); font-weight: 700; }

  /* ---------- Credits ---------- */
  .tiles { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .tile { position: relative; min-height: 460px; border-radius: var(--r-lg); overflow: hidden; color: var(--ivory); display: flex; isolation: isolate; background: var(--stage); box-shadow: 0 30px 60px -36px rgba(10,30,90,.9); }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(5,11,28,.05) 20%, rgba(5,11,28,.6) 50%, rgba(5,11,28,.95) 85%); }
  .tile-body { position: relative; z-index: 2; margin-top: auto; padding: 1.6rem 1.6rem 2.2rem; display: grid; gap: .5rem; justify-items: start; }
  .tile h3 { font-size: var(--step-2); line-height: 1.05; }
  .tile p { color: rgba(238,241,248,.88); }
  .after { margin-top: 2rem; font-weight: 700; }
  .tq p { font-size: var(--step-2); }
</style>

<script>
  const why = document.querySelector<HTMLElement>('[data-why]');
  if (why) {
    const btns = [...why.querySelectorAll<HTMLButtonElement>('[data-strength]')];
    const figs = [...why.querySelectorAll<HTMLElement>('[data-fig]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0, timer = 0, auto = !reduce;
    const select = (n: number) => {
      idx = (n + btns.length) % btns.length;
      const key = btns[idx].dataset.strength;
      btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === idx)));
      figs.forEach((f) => {
        const on = f.dataset.fig === key;
        f.classList.toggle('was-on', f.classList.contains('is-on') && !on);
        f.classList.toggle('is-on', on);
      });
      setTimeout(() => figs.forEach((f) => !f.classList.contains('is-on') && f.classList.remove('was-on')), 1200);
      // restart the progress line
      const bar = btns[idx].querySelector<HTMLElement>('.st-prog span'); if (bar) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
    };
    const cycle = () => { clearTimeout(timer); if (auto) timer = window.setTimeout(() => { select(idx + 1); cycle(); }, 5500); };
    const stopAuto = () => { auto = false; why.classList.remove('cycling'); clearTimeout(timer); };
    btns.forEach((b, k) => {
      b.addEventListener('click', () => { stopAuto(); select(k); });
      b.addEventListener('mouseenter', () => { if (matchMedia('(hover: hover)').matches) { stopAuto(); select(k); } });
    });
    if (reduce || !('IntersectionObserver' in window)) { why.classList.add('lit'); }
    else {
      new IntersectionObserver(([e], io) => {
        if (!e.isIntersecting) return;
        why.classList.add('lit'); io.disconnect();
        setTimeout(() => { if (auto) { why.classList.add('cycling'); select(0); cycle(); } }, 1400);
      }, { threshold: .3 }).observe(why);
    }
  }
</script>
