---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { services, withTag, kindOf } from '../lib/data';
import { stages, stagePos, photos, type StageKey, type PhotoKey } from '../lib/photos';

const steps = [
  { t: 'Enquiry', d: "Share the date, venue, format and audience. I'll confirm availability." },
  { t: 'Brief', d: 'We talk through objectives, audience, speakers, sponsors and the tone you want the day to have.' },
  { t: 'Preparation', d: 'I go through the programme and prepare introductions, names, titles and any questions for guests.' },
  { t: 'Sound check', d: 'A quick technical check and walk-through with your team wherever the schedule allows.' },
  { t: 'On the day', d: 'I arrive early, work to your cues and adjust live when the programme moves.' },
  { t: 'The close', d: 'A finish that sends people out on the right note, and on time.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Imelda Mutio: hosting services',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Service', name: s.name, description: s.short, provider: { '@id': new URL('/#imelda-mutio', Astro.site).href }, areaServed: 'Kenya' } })) };
---
<Base title="MC & Event Hosting Services" description="Book Imelda Mutio as MC or host for corporate events, conferences, panels, award shows, galas, brand activations, workshops and voice-over in Nairobi and across Kenya." schema={[schema]}>
  <PageHero kicker="Services" title="Events I can host." lede="Six ways to work with me. Each one starts with your audience and ends with a room that stayed with you." stage="event-hall" cutout="orange" />

  <nav class="svc-nav room" aria-label="Services on this page">
    <ul class="wrap">{services.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}</ul>
  </nav>

  {services.map((s, i) => {
    const evidence = s.tags.flatMap((t) => withTag(t)).filter((e, k, arr) => arr.findIndex((x) => x.id === e.id) === k).slice(0, 3);
    const p = photos[s.photo as PhotoKey];
    return (
      <section id={s.id} class:list={['band stage', { flip: i % 2 }]} aria-labelledby={`${s.id}-h`}>
        <div class="backdrop" aria-hidden="true"><Image src={stages[s.stage as StageKey]} alt="" widths={[700, 1300, 1800]} sizes="100vw" loading="lazy" style={`object-position:${stagePos[s.stage as StageKey]}`} /></div>
        <div class="wrap band-grid">
          <div class="band-photo reveal"><Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 960px) 32vw, 92vw" style={`object-position:${p.pos}`} loading="lazy" /></div>
          <div class="band-card reveal" style="--d:.15s">
            <h2 id={`${s.id}-h`} class="h2" data-split>{s.name}</h2>
            <p class="short">{s.short}</p>
            <div class="nr">
              <div><h3>The need</h3><p>{s.need}</p></div>
              <div><h3>My role</h3><p>{s.role}</p></div>
            </div>
            <ul class="brings">{s.contributes.map((c) => <li>{c}</li>)}</ul>
            <p class="outcome">{s.outcome}</p>
            <p class="formats">{s.formats.map((f) => <span>{f}</span>)}</p>
            {s.note && <p class="note">{s.note}</p>}
            {evidence.length > 0 && (
              <div class="ev">
                <h3>Related</h3>
                <ul>{evidence.map((e) => <li><span class={`badge ${kindOf(e).cls}`}>{kindOf(e).label}</span> {e.youtubeId ? <button type="button" class="text-link evb" data-video={e.youtubeId} data-video-title={e.title}>{e.title}</button> : <a class="text-link" href={e.url} target="_blank" rel="noopener">{e.title}<span class="sr-only"> (opens in a new tab)</span></a>}</li>)}</ul>
              </div>
            )}
            <a href={`/contact/?service=${encodeURIComponent(s.name)}`} class="btn btn--primary">Enquire about this</a>
          </div>
        </div>
      </section>
    );
  })}

  <section class="room section" aria-labelledby="proc-h">
    <div class="wrap">
      <div class="head head--split">
        <div><p class="kicker">Working with me</p><h2 id="proc-h" class="h1" data-split>From first call to final thank-you.</h2></div>
        <p class="lede">A simple process that works for in-house teams and event agencies alike.</p>
      </div>
      <ol class="steps">
        {steps.map((st, i) => <li class="reveal" style={`--d:${i * 0.08}s`}><span class="n" aria-hidden="true">{i + 1}</span><h3>{st.t}</h3><p>{st.d}</p></li>)}
      </ol>
    </div>
  </section>
</Base>
<style>
  .svc-nav { position: sticky; top: var(--header-h); z-index: 20; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .svc-nav ul { list-style: none; padding-block: .8rem; display: flex; gap: .5rem; overflow-x: auto; scrollbar-width: none; }
  .svc-nav ul::-webkit-scrollbar { display: none; }
  .svc-nav a { display: inline-flex; align-items: center; min-height: 40px; white-space: nowrap; padding: .4em 1em; border-radius: 999px; border: 1.5px solid var(--line); text-decoration: none; font-weight: 700; font-size: .88rem; }
  .svc-nav a:hover { border-color: var(--text); }
  .band { padding-block: clamp(4rem, 3rem + 5vw, 8rem); scroll-margin-top: calc(var(--header-h) + 60px); }
  .band .backdrop::after { background: linear-gradient(180deg, rgba(5,11,28,.72), rgba(5,11,28,.9)); }
  .band-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 960px) { .band-grid { grid-template-columns: 1fr 1.35fr; gap: 4rem; } .flip .band-photo { order: 2; } }
  .band-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--r-lg); box-shadow: 0 40px 80px -40px rgba(0,0,0,.9); }
  @media (max-width: 959px) { .band-photo :global(img) { aspect-ratio: 16 / 11; } }
  .band-card { display: grid; gap: 1.3rem; justify-items: start; padding: clamp(1.5rem, 1rem + 2vw, 2.75rem); border-radius: var(--r-lg); background: rgba(10, 21, 51, .55); border: 1px solid var(--stage-line); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .short { font-size: var(--step-1); color: rgba(238,241,248,.88); }
  .nr { display: grid; gap: 1rem; width: 100%; }
  @media (min-width: 640px) { .nr { grid-template-columns: 1fr 1fr; gap: 1.6rem; } }
  .nr h3, .ev h3 { font-size: .95rem; letter-spacing: 0; color: var(--copper); margin-bottom: .3rem; }
  .nr p { color: var(--mist); }
  .brings { list-style: none; padding: 0; display: grid; gap: .55rem; }
  .brings li { padding-left: 1.6rem; position: relative; }
  .brings li::before { content: ''; position: absolute; left: 0; top: .5em; width: 9px; height: 9px; border-radius: 50%; background: var(--copper); box-shadow: 0 0 10px var(--copper); }
  .outcome { font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.03em; }
  .formats { display: flex; flex-wrap: wrap; gap: .45rem; }
  .formats span { padding: .35em .85em; border-radius: 999px; border: 1px solid var(--stage-line); font-size: .85rem; }
  .note { font-size: var(--step--1); color: var(--mist); border-left: 2px solid var(--copper); padding-left: .8rem; }
  .ev ul { list-style: none; padding: 0; display: grid; gap: .5rem; }
  .ev li { font-size: .95rem; }
  .evb { all: unset; cursor: pointer; color: var(--link); text-decoration: underline; text-underline-offset: .2em; }
  .evb:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .steps { list-style: none; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); counter-reset: s; position: relative; }
  .steps li { position: relative; padding: 1.6rem; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); display: grid; gap: .5rem; align-content: start; }
  .n { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; background: var(--copper); color: var(--stage); box-shadow: 0 0 22px rgba(240,120,50,.5); margin-bottom: .4rem; }
  .steps h3 { font-size: var(--step-1); }
  .steps p { color: var(--text-2); }
</style>
